# Copy to .env; explicit process environment variables override these values.
APP_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3000
DATA_DIR=data
RUST_LOG=managed_tv_panel=info,tower_http=info

# Never store bootstrap passwords here. Set ADMIN_USERNAME in PowerShell,
# then run: cargo run -- bootstrap-admin (hidden password prompt).
# For emulator downloads: PUBLIC_BASE_URL=http://10.0.2.2:3000
# Keep ADMIN_ORIGIN=http://localhost:3000 if browsing locally.
# Production: APP_ENV=production and both origins must use https://.
